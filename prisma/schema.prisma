generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model apartments {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unit_number    String           @db.VarChar(20)
  block          String?          @db.VarChar(50)
  floor          Int?
  resident_id    String?          @unique @db.Uuid
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  users          users?           @relation(fields: [resident_id], references: [id], onUpdate: NoAction, map: "fk_apartment_resident")
  visitor_passes visitor_passes[]

  @@unique([unit_number, block], map: "unique_unit")
}

model users {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name      String           @db.VarChar(100)
  email          String           @unique @db.VarChar(255)
  phone          String?          @db.VarChar(20)
  password_hash  String
  role           user_role
  status         user_status      @default(active)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  apartments     apartments?
  visit_logs     visit_logs[]
  visitor_passes visitor_passes[]

  @@index([email], map: "idx_users_email")
}

model visit_logs {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_pass_id String         @db.Uuid
  guard_id        String         @db.Uuid
  action          visit_action
  timestamp       DateTime       @default(now()) @db.Timestamptz(6)
  users           users          @relation(fields: [guard_id], references: [id], onUpdate: NoAction, map: "fk_log_guard")
  visitor_passes  visitor_passes @relation(fields: [visitor_pass_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_log_pass")

  @@index([guard_id], map: "idx_logs_guard")
  @@index([visitor_pass_id], map: "idx_logs_pass")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model visitor_passes {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_id          String              @db.Uuid
  resident_id         String              @db.Uuid
  apartment_id        String              @db.Uuid
  purpose             visit_purpose
  notes               String?
  num_of_guests       Int                 @default(1)
  expected_arrival_at DateTime            @db.Timestamptz(6)
  expires_at          DateTime            @db.Timestamptz(6)
  qr_token            String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status              visitor_pass_status @default(pending)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  cancelled_at        DateTime?           @db.Timestamptz(6)
  visit_logs          visit_logs[]
  apartments          apartments          @relation(fields: [apartment_id], references: [id], onUpdate: NoAction, map: "fk_pass_apartment")
  users               users               @relation(fields: [resident_id], references: [id], onUpdate: NoAction, map: "fk_pass_resident")
  visitors            visitors            @relation(fields: [visitor_id], references: [id], onUpdate: NoAction, map: "fk_pass_visitor")

  @@index([expected_arrival_at], map: "idx_pass_arrival")
  @@index([resident_id], map: "idx_pass_resident")
  @@index([status], map: "idx_pass_status")
  @@index([visitor_id], map: "idx_pass_visitor")
}

model visitors {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name      String           @db.VarChar(100)
  phone          String?          @db.VarChar(20)
  vehicle_reg    String?          @db.VarChar(20)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  visitor_passes visitor_passes[]
}

enum user_role {
  resident
  guard
  admin
}

enum user_status {
  active
  disabled
}

enum visit_action {
  check_in
  check_out
}

enum visit_purpose {
  family
  friend
  delivery
  maintenance
  business
  other
}

enum visitor_pass_status {
  pending
  checked_in
  checked_out
  expired
  cancelled
}
